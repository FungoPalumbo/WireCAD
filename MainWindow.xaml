<Window x:Class="WireCAD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WireCAD.Controls"
        Title="WireCAD – CAD per cablaggi"
        Icon="Assets/WireCAD.ico"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Stroke" Value="#374151"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
        <Menu>
            <MenuItem ToolTip="File">
                <MenuItem.Header>
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19"/></Canvas></Viewbox>
                </MenuItem.Header>
                <MenuItem Header="_Nuovo" InputGestureText="Ctrl+N" Click="MenuNew_Click"/>
                <MenuItem Header="_Apri progetto..." InputGestureText="Ctrl+O" Click="MenuOpen_Click"/>
                <MenuItem Header="_Salva" InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem Header="Salva con _nome..." InputGestureText="Ctrl+Maiusc+S" Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="_Importa">
                    <MenuItem Header="Forme da file..." Click="MenuImport_Click"/>
                    <MenuItem Header="Connettore da file..." Click="MenuImportConnector_Click"/>
                    <MenuItem Header="DXF / DWG..." Click="MenuImportCad_Click"/>
                    <MenuItem Header="Immagine (JPG, BMP, PNG)..." Click="MenuImportImage_Click"/>
                    <MenuItem Header="Campi del cartiglio..." Click="MenuImportTitleBlock_Click"/>
                </MenuItem>
                <MenuItem Header="_Esporta">
                    <MenuItem Header="Disegno come DXF (*.dxf)..." Click="MenuExportDxf_Click"/>
                    <MenuItem Header="Disegno come DWG (*.dwg)..." Click="MenuExportDwg_Click"/>
                    <MenuItem Header="Disegno come PDF (*.pdf)..." Click="MenuExportPdf_Click"/>
                    <MenuItem Header="Disegno come SVG (*.svg)..." Click="MenuExportSvg_Click"/>
                    <Separator/>
                    <MenuItem Header="Selezione come forme..." Click="MenuSaveSelection_Click"/>
                    <MenuItem Header="Selezione come connettore..." Click="MenuSaveConnector_Click"/>
                    <Separator/>
                    <MenuItem Header="Campi del cartiglio..." Click="MenuExportTitleBlock_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Apri cartella connettori" Click="MenuOpenConnectorFolder_Click"/>
                <Separator/>
                <MenuItem Header="_Esci" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem ToolTip="Modifica">
                <MenuItem.Header>
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M4,20 L5,15 L16,4 L20,8 L9,19 Z M14,6 L18,10"/></Canvas></Viewbox>
                </MenuItem.Header>
                <MenuItem Header="_Annulla" InputGestureText="Ctrl+Z" Click="MenuUndo_Click"/>
                <MenuItem Header="_Ripeti" InputGestureText="Ctrl+Y" Click="MenuRedo_Click"/>
                <Separator/>
                <MenuItem Header="_Copia" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                <MenuItem Header="_Incolla" InputGestureText="Ctrl+V" Click="MenuPaste_Click"/>
                <MenuItem Header="Seleziona _tutto" InputGestureText="Ctrl+A" Click="MenuSelectAll_Click"/>
                <Separator/>
                <MenuItem Header="Ruota 90°" InputGestureText="Ctrl+R" Click="MenuRotate_Click"/>
                <MenuItem Header="Specchia orizzontalmente" InputGestureText="Ctrl+M" Click="MenuMirrorH_Click"/>
                <MenuItem Header="Specchia verticalmente" InputGestureText="Ctrl+Maiusc+M" Click="MenuMirrorV_Click"/>
                <Separator/>
                <MenuItem Header="Elimina" InputGestureText="Canc" Click="BtnDelete_Click"/>
            </MenuItem>
            <MenuItem ToolTip="Cablaggio">
                <MenuItem.Header>
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M13,3 L5,13 H11 L10,21 L19,10 H13 Z"/></Canvas></Viewbox>
                </MenuItem.Header>
                <MenuItem Header="Numera fili per potenziale..." Click="MenuNumberWires_Click"/>
                <MenuItem Header="Controlli di coerenza (ERC)..." Click="MenuErc_Click"/>
                <Separator/>
                <MenuItem Header="Inserisci tabella fili nel disegno" Click="MenuWireTable_Click"/>
                <MenuItem Header="Inserisci distinta materiali nel disegno" Click="MenuBomTable_Click"/>
                <Separator/>
                <MenuItem Header="Esporta distinta fili (CSV)..." Click="MenuWireList_Click"/>
                <MenuItem Header="Esporta distinta materiali (CSV)..." Click="MenuBom_Click"/>
                <MenuItem Header="Esporta tabella pin (CSV)..." Click="MenuPinTable_Click"/>
            </MenuItem>
        </Menu>
        <ToolBarTray IsLocked="True">
            <ToolBar>
                <ToggleButton x:Name="BtnSelect" ToolTip="Selettore (S): seleziona, Canc per eliminare" Click="BtnSelect_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M5,3 V19 L9.5,15 L12.5,21 L15,20 L12,14 H18 Z"/></Canvas></Viewbox>
                </ToggleButton>
                <Separator/>
                <ToggleButton x:Name="BtnLine" ToolTip="Linea (L): due clic" Click="BtnLine_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M4,20 L20,4"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnRectangle" ToolTip="Rettangolo (R): due clic sugli angoli" Click="BtnRectangle_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M4,6 H20 V18 H4 Z"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnArc" ToolTip="Arco (A): inizio, fine, punto sull'arco. Tieni premuto o clic destro per scegliere il tipo: arco o raccordo" Click="BtnArc_Click"
                              PreviewMouseLeftButtonDown="BtnArc_PreviewMouseDown" PreviewMouseLeftButtonUp="BtnArc_PreviewMouseUp" MouseLeave="BtnArc_MouseLeave"
                              MouseRightButtonUp="BtnArc_RightClick">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M4,18 A8,8 0 0 1 20,18"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnCircle" ToolTip="Cerchio (O): centro e raggio" Click="BtnCircle_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnDimension" ToolTip="Quota (D): due punti misurati e un terzo clic per la posizione della linea di quota" Click="BtnDimension_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M4,5 V15 M20,5 V15 M4,12 H20 M4,12 L7,10 M4,12 L7,14 M20,12 L17,10 M20,12 L17,14"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnSpline" ToolTip="Spline (B): curva per punti. Doppio clic, Invio o tasto destro per terminare" Click="BtnSpline_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M3,18 C7,4 11,4 12,12 S17,20 21,6"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnAnchor" ToolTip="Punto ancora (P): un clic" Click="BtnAnchor_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12 M12,3 V8 M12,16 V21 M3,12 H8 M16,12 H21"/></Canvas></Viewbox>
                </ToggleButton>
                <Separator/>
                <ToggleButton x:Name="BtnComponent" ToolTip="Componente (C): dalla libreria" Click="BtnComponent_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M8,6 H16 V18 H8 Z M3,10 H8 M3,14 H8 M16,10 H21 M16,14 H21"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnWire" ToolTip="Filo (W): tra pin. Tieni premuto o clic destro per scegliere l'aspetto: linea semplice o realistico" Click="BtnWire_Click"
                              PreviewMouseLeftButtonDown="BtnWire_PreviewMouseDown" PreviewMouseLeftButtonUp="BtnWire_PreviewMouseUp" MouseLeave="BtnWire_MouseLeave"
                              MouseRightButtonUp="BtnWire_RightClick">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M3,18 H10 V7 H21"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnSheath" ToolTip="Guaina (G): racchiude i fili lungo un tracciato" Click="BtnSheath_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M3,8 H15 Q21,8 21,14 V21 M3,16 H11 Q13,16 13,18 V21 M7,8 V16 M11,8 V16"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnPin" ToolTip="Pin (N): punto numerato a cui agganciare fili e linee" Click="BtnPin_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12 M15,12 H21 M3,12 H9"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnJunction" ToolTip="Giunzione (J): tra fili" Click="BtnJunction_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M3,12 H21 M12,3 V12"/><Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="7" Height="7" Fill="#374151"/></Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="BtnText" ToolTip="Testo (T): testo libero" Click="BtnText_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M5,5 H19 M12,5 V20 M9,20 H15"/></Canvas></Viewbox>
                </ToggleButton>
                <Separator/>
                <Button ToolTip="Elimina (Canc): elimina la selezione" Click="BtnDelete_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M5,7 H19 M10,7 V4 H14 V7 M7,7 L8,20 H16 L17,7 M10,11 V16 M14,11 V16"/></Canvas></Viewbox>
                </Button>
                <Separator/>
                <Button ToolTip="Adatta vista (F): il foglio alla finestra" Click="BtnFit_Click">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15"/></Canvas></Viewbox>
                </Button>
            </ToolBar>
        </ToolBarTray>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="240"/>
            </Grid.RowDefinitions>

            <Canvas x:Name="HostCanvas" Grid.Row="0" Background="#262B33" ClipToBounds="True" Focusable="True"
                    MouseLeftButtonDown="HostCanvas_MouseLeftButtonDown"
                    MouseRightButtonUp="HostCanvas_MouseRightButtonUp"
                    MouseMove="HostCanvas_MouseMove"
                    MouseWheel="HostCanvas_MouseWheel"
                    PreviewMouseDown="HostCanvas_PreviewMouseDown"
                    PreviewMouseUp="HostCanvas_PreviewMouseUp">
                <Canvas x:Name="WorldCanvas" Width="297" Height="210" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="SheetRect" Canvas.Left="0" Canvas.Top="0" Width="297" Height="210"
                               Fill="White" Stroke="#9CA3AF" StrokeThickness="0.3"/>

                    <Path x:Name="GridMinorPath" Stroke="#CBD5E1" StrokeThickness="0.12"/>
                    <Path x:Name="GridMajorPath" Stroke="#94A3B8" StrokeThickness="0.2"/>
                    <Path x:Name="OriginMarker" Stroke="#DC2626" StrokeThickness="0.4"/>

                    <Canvas x:Name="ChromeCanvas" Canvas.Left="0" Canvas.Top="0" Width="297" Height="210"
                            Visibility="{Binding IsChecked, ElementName=CkTitleBlock, Converter={StaticResource BoolToVis}}">
                        <Border x:Name="FrameBorder" Canvas.Left="10" Canvas.Top="10" Width="277" Height="190"
                                BorderBrush="Black" BorderThickness="0.5"/>
                        <ctl:TitleBlockControl x:Name="TitleBlockCtl" Canvas.Left="107" Canvas.Top="168"/>
                    </Canvas>

                    <Canvas x:Name="DrawCanvas" Canvas.Left="0" Canvas.Top="0" Width="297" Height="210"/>
                    <Canvas x:Name="LabelCanvas" Canvas.Left="0" Canvas.Top="0" Width="297" Height="210" IsHitTestVisible="False"/>
                    <Canvas x:Name="GripCanvas" Canvas.Left="0" Canvas.Top="0" Width="297" Height="210"/>
                </Canvas>
            </Canvas>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D1D5DB"/>

            <Grid Grid.Row="2" Background="#F9FAFB">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="460"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Entità" FontWeight="Bold" Margin="8,4"/>
                    <TreeView x:Name="EntityTree" BorderThickness="0" Background="Transparent"
                              PreviewMouseLeftButtonDown="EntityTree_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="EntityTree_PreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonUp="EntityTree_PreviewMouseRightButtonUp">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border Padding="4,1" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                    <Setter Property="Background" Value="#BFDBFE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" MinWidth="110">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" Foreground="#6B7280" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>

                <Border Grid.Column="1" BorderBrush="#D1D5DB" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PropertiesPanel" Margin="8,4">
                            <TextBlock Text="Proprietà entità selezionata" FontWeight="Bold"/>
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Nome" VerticalAlignment="Center"/>
                                <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" LostFocus="NameBox_LostFocus"/>
                                <CheckBox x:Name="NameShowBox" Grid.Column="2" IsChecked="{Binding ShowName, Mode=TwoWay}" Click="FieldShown_Click"
                                          Margin="8,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Mostra il nome sul foglio accanto all'oggetto"/>
                            </Grid>
                            <CheckBox x:Name="LabelShowBox" Content="Mostra l'etichetta scritta sull'oggetto (numero, tag, descrizione)"
                                      IsChecked="{Binding ShowLabel, Mode=TwoWay}" Click="FieldShown_Click" Margin="0,2,0,6"
                                      ToolTip="Nasconde o mostra la scritta in linea con l'oggetto; i numeri dei pin restano visibili"/>
                            <ItemsControl x:Name="TextFieldsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding IsShown, Mode=TwoWay}" Click="FieldShown_Click"
                                                      Margin="8,0,0,0" VerticalAlignment="Center"
                                                      ToolTip="Mostra questa proprietà sul foglio accanto all'oggetto"/>
                                            <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" KeyDown="FieldTextBox_KeyDown" LostFocus="FieldTextBox_LostFocus"
                                                     Text="{Binding Value, UpdateSourceTrigger=LostFocus}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasChoices}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Choices}"
                                                      Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                      Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}"
                                                      DropDownClosed="FieldCombo_DropDownClosed" KeyDown="FieldCombo_KeyDown"
                                                      LostFocus="FieldTextBox_LostFocus"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="FieldsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" KeyDown="FieldTextBox_KeyDown" LostFocus="FieldTextBox_LostFocus"
                                                     Text="{Binding Value, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="mm" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#6B7280"/>
                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsShown, Mode=TwoWay}" Click="FieldShown_Click"
                                                      Margin="8,0,0,0" VerticalAlignment="Center"
                                                      ToolTip="Mostra questa proprietà sul foglio accanto all'oggetto"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            </Grid>

            <Border Grid.Column="1" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Libreria connettori" FontSize="14" FontWeight="Bold"/>
                        <ListBox x:Name="LibraryList" DisplayMemberPath="Name" Height="170" Margin="0,6,0,6"
                                 SelectionChanged="LibraryList_SelectionChanged"/>
                        <CheckBox x:Name="CkObjSnap" Content="Snap a cavità e vertici" IsChecked="True" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CkOrtho" Content="Fili ortogonali (spegni per angoli liberi)" IsChecked="False" Margin="0,0,0,16"/>
                        <TextBlock Text="Cartiglio" FontSize="14" FontWeight="Bold"/>
                        <CheckBox x:Name="CkTitleBlock" Content="Mostra cartiglio e cornice" IsChecked="True" Margin="0,6,0,10"/>

                        <TextBlock Text="Titolo" FontSize="11" Foreground="#4B5563"/>
                        <TextBox Text="{Binding DrawingTitle, ElementName=TitleBlockCtl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

                        <TextBlock Text="Azienda" FontSize="11" Foreground="#4B5563"/>
                        <TextBox Text="{Binding CompanyName, ElementName=TitleBlockCtl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

                        <TextBlock Text="Autore" FontSize="11" Foreground="#4B5563"/>
                        <TextBox Text="{Binding AuthorName, ElementName=TitleBlockCtl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

                        <TextBlock Text="N. disegno" FontSize="11" Foreground="#4B5563"/>
                        <TextBox Text="{Binding DrawingNumber, ElementName=TitleBlockCtl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Scala" FontSize="11" Foreground="#4B5563"/>
                                <TextBox Text="{Binding ScaleValue, ElementName=TitleBlockCtl, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Data" FontSize="11" Foreground="#4B5563"/>
                                <TextBox Text="{Binding DateValue, ElementName=TitleBlockCtl, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Revisione" FontSize="11" Foreground="#4B5563"/>
                                <TextBox Text="{Binding RevisionValue, ElementName=TitleBlockCtl, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Foglio" FontSize="11" Foreground="#4B5563"/>
                        <TextBox Text="{Binding SheetValue, ElementName=TitleBlockCtl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,16"/>

                        <TextBlock Text="Foglio (mm)" FontSize="14" FontWeight="Bold"/>
                        <ComboBox x:Name="SheetPresetBox" DisplayMemberPath="Label" Margin="0,6,0,6"
                                  SelectionChanged="SheetPresetBox_SelectionChanged"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Larghezza" FontSize="11" Foreground="#4B5563"/>
                                <TextBox x:Name="SheetWidthBox" KeyDown="SheetBox_KeyDown" LostFocus="SheetBox_LostFocus"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Altezza" FontSize="11" Foreground="#4B5563"/>
                                <TextBox x:Name="SheetHeightBox" KeyDown="SheetBox_KeyDown" LostFocus="SheetBox_LostFocus"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Ruota" VerticalAlignment="Bottom" Padding="8,1"
                                    ToolTip="Scambia larghezza e altezza" Click="BtnRotateSheet_Click"/>
                        </Grid>

                        <TextBlock Text="Griglia (mm)" FontSize="14" FontWeight="Bold"/>
                        <CheckBox x:Name="CkGrid" Content="Mostra griglia" IsChecked="True" Margin="0,6,0,6"
                                  Checked="GridVisibility_Changed" Unchecked="GridVisibility_Changed"/>
                        <CheckBox x:Name="CkSnap" Content="Snap ai nodi della griglia" IsChecked="True" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Passo (mm)" FontSize="11" Foreground="#4B5563"/>
                                <TextBox x:Name="GridStepBox" KeyDown="GridBox_KeyDown" LostFocus="GridBox_LostFocus"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Principale ogni (righe)" FontSize="11" Foreground="#4B5563"/>
                                <TextBox x:Name="GridMajorBox" KeyDown="GridBox_KeyDown" LostFocus="GridBox_LostFocus"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Origine X (mm)" FontSize="11" Foreground="#4B5563"/>
                                <TextBox x:Name="OriginXBox" KeyDown="GridBox_KeyDown" LostFocus="GridBox_LostFocus"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Origine Y (mm)" FontSize="11" Foreground="#4B5563"/>
                                <TextBox x:Name="OriginYBox" KeyDown="GridBox_KeyDown" LostFocus="GridBox_LostFocus"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Scegli origine sul foglio" Margin="0,8,0,0" Padding="4,2" Click="BtnPickOrigin_Click"/>
                        <Button Content="Origine sul foglio (0; 0)" Margin="0,4,0,0" Padding="4,2"
                                ToolTip="Angolo in alto a sinistra del foglio" Click="BtnResetOrigin_Click"/>
                        <Button Content="Origine sulla cornice (10; 10)" Margin="0,4,0,0" Padding="4,2"
                                ToolTip="Angolo in alto a sinistra della cornice del disegno" Click="BtnOriginOnFrame_Click"/>

                        <TextBlock Text="Comandi" FontSize="14" FontWeight="Bold" Margin="0,16,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#4B5563"
                                   Text="Rotella: zoom – Tasto centrale: pan – Selettore: clic per selezionare, trascina nel vuoto per selezionare con un rettangolo (sinistra→destra: oggetti interi, destra→sinistra: anche quelli toccati; Ctrl/Maiusc aggiunge), trascina un oggetto per spostarlo, trascina i quadratini per modificare i punti – Tasto destro: sulle forme selezionate salva in file, su un punto vuoto importa da file – Tutte le coordinate sono in mm, con origine nell'angolo in alto a sinistra del foglio (Y verso il basso) – Esc: annulla o deseleziona – Canc: elimina l'entità selezionata – F: adatta il foglio alla finestra – C/W/J/T/G: componente, filo, giunzione, testo, guaina – Mentre traccio linee, archi, fili o guaine: Spazio tenuto premuto vincola a 0°/45°/90°; nel filo X inverte il gomito – Ctrl+Z/Y: annulla/ripeti, Ctrl+C/V: copia/incolla, Ctrl+R: ruota, Ctrl+M: specchia, Ctrl+S: salva progetto."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E5E7EB" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusHint" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusCoords" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusZoom" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusCount" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
