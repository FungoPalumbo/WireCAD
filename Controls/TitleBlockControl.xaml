<UserControl x:Class="WireCAD.Controls.TitleBlockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="180" d:DesignHeight="32"
             Width="180" Height="32">
    <Border BorderBrush="Black" BorderThickness="0.4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="11"/>
                <RowDefinition Height="11"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0.25,0.25">
                <StackPanel Margin="1" VerticalAlignment="Center">
                    <TextBlock FontSize="1.9" Foreground="#6B7280" Text="AZIENDA"/>
                    <TextBlock FontSize="3" Text="{Binding CompanyName, RelativeSource={RelativeSource AncestorType=UserControl}}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0,0,0,0.25">
                <StackPanel Margin="1" VerticalAlignment="Center">
                    <TextBlock FontSize="1.9" Foreground="#6B7280" Text="TITOLO"/>
                    <TextBlock FontSize="3.6" FontWeight="Bold" Text="{Binding DrawingTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0.25,0.25">
                <StackPanel Margin="1" VerticalAlignment="Center">
                    <TextBlock FontSize="1.9" Foreground="#6B7280" Text="DIS. N."/>
                    <TextBlock FontSize="3" Text="{Binding DrawingNumber, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0.25,0.25">
                <StackPanel Margin="1" VerticalAlignment="Center">
                    <TextBlock FontSize="1.9" Foreground="#6B7280" Text="SCALA"/>
                    <TextBlock FontSize="3" Text="{Binding ScaleValue, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,0,0.25">
                <StackPanel Margin="1" VerticalAlignment="Center">
                    <TextBlock FontSize="1.9" Foreground="#6B7280" Text="DATA"/>
                    <TextBlock FontSize="3" Text="{Binding DateValue, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0">
                <StackPanel Margin="1" VerticalAlignment="Center">
                    <TextBlock FontSize="1.9" Foreground="#6B7280" Text="AUTORE"/>
                    <TextBlock FontSize="3" Text="{Binding AuthorName, RelativeSource={RelativeSource AncestorType=UserControl}}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="1">
                <StackPanel Margin="1" VerticalAlignment="Center">
                    <TextBlock FontSize="1.9" Foreground="#6B7280" Text="REV."/>
                    <TextBlock FontSize="3" Text="{Binding RevisionValue, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="2">
                <StackPanel Margin="1" VerticalAlignment="Center">
                    <TextBlock FontSize="1.9" Foreground="#6B7280" Text="FOGLIO"/>
                    <TextBlock FontSize="3" Text="{Binding SheetValue, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
