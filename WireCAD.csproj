<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WireCAD</RootNamespace>
    <AssemblyName>WireCAD</AssemblyName>
    <ApplicationIcon>Assets\WireCAD.ico</ApplicationIcon>
    <Product>WireCAD</Product>
    <Description>CAD per il disegno di cablaggi industriali</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\WireCAD.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.8.0" />
  </ItemGroup>

</Project>
